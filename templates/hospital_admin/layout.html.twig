<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Hospital portal{% endblock %} | KATOC</title>
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
    <button class="admin-menu-toggle" type="button" aria-expanded="false" aria-controls="admin-sidebar">
        <span aria-hidden="true">☰</span>
        <span class="sr-only">Open hospital navigation</span>
    </button>
    <div class="admin-shell">
        <aside class="admin-sidebar" id="admin-sidebar">
            <a href="{{ path('app_hospital_admin_dashboard') }}" class="admin-brand">
                <img src="/images/katoc-icon.png" alt="">
                <span><strong>KATOC</strong><small>HOSPITAL PORTAL</small></span>
            </a>
            <nav class="admin-nav" aria-label="Hospital navigation">
                <span class="admin-nav-label">WORKSPACE</span>
                <a class="{{ active_nav == 'dashboard' ? 'is-active' : '' }}" href="{{ path('app_hospital_admin_dashboard') }}"><span class="admin-nav-icon">⌂</span>Dashboard</a>
                <a class="{{ active_nav == 'records' ? 'is-active' : '' }}" href="{{ path('app_hospital_admin_records') }}"><span class="admin-nav-icon">▤</span>Appointments</a>
            </nav>
            <div class="admin-sidebar-footer">
                <a href="{{ path('app_home') }}" class="admin-view-site">← View KATOC website</a>
                <a href="{{ path('app_logout') }}" class="admin-logout"><span class="admin-nav-icon">↪</span>Log out</a>
                <div class="admin-sidebar-user">
                    <span class="admin-avatar">{{ app.user.name|slice(0, 1)|upper }}</span>
                    <span><strong>{{ app.user.name }}</strong><small>Hospital administrator</small></span>
                </div>
            </div>
        </aside>
        <div class="admin-sidebar-backdrop" hidden></div>
        <div class="admin-content-wrap">
            <header class="admin-topbar">
                <div>
                    <span class="admin-topbar-label">KIDNEY ACCESS &amp; TREATMENT OPERATIONS</span>
                    <strong>{% block section_label %}Hospital portal{% endblock %}</strong>
                </div>
                <span class="admin-topbar-profile">{{ app.user.name }}</span>
            </header>
            <main class="admin-main">
                {% for type in ['success', 'error'] %}
                    {% for message in app.flashes(type) %}
                        <div class="flash flash-{{ type }}" role="status">{{ message }}</div>
                    {% endfor %}
                {% endfor %}
                {% block body %}{% endblock %}
            </main>
        </div>
    </div>
    <script src="/js/admin.js" defer></script>
</body>
</html>
