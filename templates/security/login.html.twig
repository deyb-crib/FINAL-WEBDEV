<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Log in | KATOC</title>
    <link rel="stylesheet" href="/css/auth.css?v=20261111-3">
</head>
<body class="auth-login-page">
    <main class="auth-shell">
        <section class="auth-visual">
            <div class="auth-logo-stage">
                <img src="/images/katoc-logo2.png" alt="KATOC" class="auth-logo">
            </div>
            <div class="auth-visual-content">
                <span class="auth-eyebrow">KIDNEY ACCESS AND TREATMENT OPERATION CENTER</span>
                <h1>Your care starts here.</h1>
                <p>Sign in to find dialysis centers, review care information, and manage your appointment requests.</p>
            </div>
        </section>

        <section class="auth-form-panel">
            <div class="auth-form-wrap">
                <img src="/images/katoc-logo2.png" alt="KATOC" class="auth-form-logo-mark">
                <h2>{{ admin_mode ? 'System admin sign in' : (hospital_mode ? 'Hospital sign in' : 'Log in to KATOC') }}</h2>
                <p class="auth-intro">
                    {% if admin_mode %}
                        Sign in to manage the KATOC system and all dialysis centers.
                    {% elseif hospital_mode %}
                        Sign in to view and manage bookings for your assigned hospital.
                    {% else %}
                        Access your dialysis care information and appointment requests.
                    {% endif %}
                </p>

                {% for message in app.flashes('success') %}
                    <div class="auth-success" role="status">{{ message }}</div>
                {% endfor %}
                {% if error and not already_authenticated %}
                    <div class="auth-error" role="alert"><div>Invalid email or password.</div></div>
                {% endif %}

                {% if already_authenticated %}
                    <div class="auth-error" role="status">You are already signed in. Log out first to switch accounts.</div>
                    <a class="auth-submit auth-admin-logout" href="{{ path('app_logout') }}">Log out</a>
                {% else %}
                    <form class="auth-form" method="post" action="{{ path('app_login') }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                        <div class="form-field">
                            <label for="email">Email address</label>
                            <input type="email" id="email" name="email" value="{{ last_username }}" autocomplete="email" required>
                        </div>
                        <div class="form-field">
                            <label for="password">Password</label>
                            <input type="password" id="password" name="password" autocomplete="current-password" required>
                            <label class="password-toggle" for="password-visibility">
                                <input type="checkbox" id="password-visibility">
                                <span>Show password</span>
                            </label>
                        </div>
                        <button type="submit" class="auth-submit">{{ admin_mode ? 'Sign in as system admin' : (hospital_mode ? 'Sign in to hospital portal' : 'Get started') }}</button>
                    </form>

                    {% if admin_mode or hospital_mode %}
                        <div class="auth-admin-entry">
                            {% if admin_mode %}
                                <span>Need a system administrator account?</span>
                                <a class="auth-admin-button" href="{{ path('app_admin_register') }}">System admin sign up</a>
                            {% else %}
                                <span>Hospital accounts are created by the KATOC system administrator.</span>
                            {% endif %}
                        </div>
                        <p class="auth-switch">
                            {% if admin_mode %}
                                <a href="{{ path('app_hospital_login') }}">Hospital administrator sign in</a>
                                · <a href="{{ path('app_login') }}">Patient sign in</a>
                            {% else %}
                                <a href="{{ path('app_admin_login') }}">System administrator sign in</a>
                                · <a href="{{ path('app_login') }}">Patient sign in</a>
                            {% endif %}
                        </p>
                    {% else %}
                        <div class="auth-admin-entry">
                            <span>Administrator sign in</span>
                            <a class="auth-admin-button" href="{{ path('app_admin_login') }}">System administrator</a>
                            <a class="auth-admin-button auth-hospital-button" href="{{ path('app_hospital_login') }}">Hospital administrator</a>
                        </div>
                        <p class="auth-switch">Don't have an account? <a href="{{ path('app_register') }}">Sign up</a></p>
                    {% endif %}
                {% endif %}

                <a href="{{ path('app_home') }}" class="auth-back">Back to homepage</a>
            </div>
        </section>
    </main>
    <script src="/js/auth.js"></script>
</body>
</html>
