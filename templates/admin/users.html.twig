{% extends 'admin/layout.html.twig' %}

{% set active_nav = 'users' %}
{% block title %}User management{% endblock %}
{% block section_label %}User management{% endblock %}

{% block body %}
    <div class="admin-page-heading">
        <div><span class="admin-eyebrow">ACCOUNTS</span><h1>User management</h1><p>Manage patient, hospital administrator, and system administrator accounts and access.</p></div>
        <a class="admin-button admin-button-primary" href="{{ path('app_admin_user_new') }}">＋ Add user</a>
    </div>
    <section class="admin-panel">
        <form class="admin-filter-form" method="get">
            <label class="sr-only" for="user-search">Search users</label>
            <input id="user-search" name="q" value="{{ search }}" placeholder="Search name or email">
            <label class="sr-only" for="user-role">Filter by role</label>
            <select id="user-role" name="role"><option value="all">All roles</option><option value="patient"{{ role_filter == 'patient' ? ' selected' : '' }}>Patient</option><option value="hospital_admin"{{ role_filter == 'hospital_admin' ? ' selected' : '' }}>Hospital administrator</option><option value="admin"{{ role_filter == 'admin' ? ' selected' : '' }}>System administrator</option></select>
            <label class="sr-only" for="user-status">Filter by account status</label>
            <select id="user-status" name="status"><option value="all">All accounts</option><option value="active"{{ status_filter == 'active' ? ' selected' : '' }}>Active</option><option value="inactive"{{ status_filter == 'inactive' ? ' selected' : '' }}>Inactive</option></select>
            <button class="admin-button admin-button-primary" type="submit">Apply filters</button>
            {% if search or role_filter != 'all' or status_filter != 'all' %}<a class="admin-button admin-button-quiet" href="{{ path('app_admin_users') }}">Clear</a>{% endif %}
            <span class="admin-filter-count">{{ total }} users</span>
        </form>
        {% if users %}
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead><tr><th>User</th><th>Role</th><th>Joined</th><th>Account</th><th>Actions</th></tr></thead>
                    <tbody>
                    {% for user in users %}
                        <tr>
                            <td><a class="admin-user-cell" href="{{ path('app_admin_user_show', {id: user.id}) }}"><span class="admin-avatar">{{ user.name|slice(0, 1)|upper }}</span><span><strong>{{ user.name }}</strong><small>{{ user.email }}</small></span></a></td>
                            <td><span class="admin-role-pill">{{ user.isAdmin ? 'System administrator' : (user.isHospitalAdmin ? 'Hospital administrator' : 'Patient') }}</span></td>
                            <td>{{ user.createdAt|date('M j, Y') }}</td>
                            <td><span class="admin-status {{ user.active ? 'status-active' : 'status-inactive' }}">{{ user.active ? 'Active' : 'Inactive' }}</span></td>
                            <td><div class="admin-row-actions">
                                <a class="admin-row-link" href="{{ path('app_admin_user_edit', {id: user.id}) }}">Edit</a>
                                {% if user.id != app.user.id %}
                                    <form method="post" action="{{ path('app_admin_user_status', {id: user.id}) }}" onsubmit="return confirm('{{ user.active ? 'Deactivate' : 'Activate' }} this account?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin-user-status-' ~ user.id) }}">
                                        <button class="admin-link-button" type="submit">{{ user.active ? 'Deactivate' : 'Activate' }}</button>
                                    </form>
                                    <form method="post" action="{{ path('app_admin_user_delete', {id: user.id}) }}" onsubmit="return confirm('Delete this account permanently? Accounts with appointment records cannot be deleted.');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin-user-delete-' ~ user.id) }}">
                                        <button class="admin-link-button admin-link-danger" type="submit">Delete</button>
                                    </form>
                                {% endif %}
                            </div></td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if page_count > 1 %}
                <nav class="admin-pagination" aria-label="User pages">
                    {% if page > 1 %}<a href="{{ path('app_admin_users', {q: search, role: role_filter, status: status_filter, page: page - 1}) }}">← Previous</a>{% endif %}
                    <span>Page {{ page }} of {{ page_count }}</span>
                    {% if page < page_count %}<a href="{{ path('app_admin_users', {q: search, role: role_filter, status: status_filter, page: page + 1}) }}">Next →</a>{% endif %}
                </nav>
            {% endif %}
        {% else %}
            <div class="admin-empty-state"><span>♙</span><strong>No matching accounts</strong><p>Try another search or filter.</p></div>
        {% endif %}
    </section>
{% endblock %}
