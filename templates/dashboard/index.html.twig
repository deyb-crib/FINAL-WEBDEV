<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Patient dashboard | KATOC</title>
    <link rel="stylesheet" href="/css/app.css?v=patient-dashboard-aria-20261108">
    <link rel="stylesheet" href="/css/patient-chrome.css?v=patient-chrome-20261108">
</head>
<body class="patient-portal site-patient-page {{ app.user ? 'has-patient-sidebar' : '' }}">
    {% include 'shared/_patient_navigation.html.twig' with {active_page: view == 'history' ? 'appointments' : 'dashboard'} %}
    <main class="app-main dashboard-main site-patient-main">
        {% for type in ['success', 'error'] %}
            {% for message in app.flashes(type) %}
                <div class="flash flash-{{ type }}" role="status">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <section class="dashboard-welcome">
            <div>
                <p class="dashboard-eyebrow">PATIENT DASHBOARD</p>
                <h1>Welcome, {{ app.user.name }}</h1>
                <p class="muted">Your appointment requests and upcoming dialysis visits, all in one place.</p>
            </div>
            <a class="btn" href="{{ path('app_hospitals') }}">Find a center <span aria-hidden="true">→</span></a>
        </section>

        <section class="dashboard-stats" aria-label="Appointment overview">
            <article class="dashboard-stat">
                <span class="dashboard-stat-icon" aria-hidden="true">▦</span>
                <div><span class="dashboard-stat-label">All requests</span><strong>{{ total_count }}</strong></div>
            </article>
            <article class="dashboard-stat">
                <span class="dashboard-stat-icon" aria-hidden="true">◷</span>
                <div><span class="dashboard-stat-label">Upcoming</span><strong>{{ upcoming_count }}</strong></div>
            </article>
            <article class="dashboard-stat">
                <span class="dashboard-stat-icon" aria-hidden="true">…</span>
                <div><span class="dashboard-stat-label">Awaiting confirmation</span><strong>{{ pending_count }}</strong></div>
            </article>
            <article class="dashboard-stat">
                <span class="dashboard-stat-icon" aria-hidden="true">✓</span>
                <div><span class="dashboard-stat-label">History</span><strong>{{ history_count }}</strong></div>
            </article>
        </section>

        <section class="dashboard-highlights" aria-label="Appointment highlights">
            <article class="dashboard-highlight">
                <div class="dashboard-section-heading">
                    <span class="dashboard-highlight-icon" aria-hidden="true">↗</span>
                    <div><h2>Next appointment</h2><p class="muted">Your next scheduled visit</p></div>
                </div>
                {% if next_appointment %}
                    <p class="highlight-date">{{ next_appointment.appointmentDate|date('D, F j, Y') }}</p>
                    <strong>{{ next_appointment.center }}</strong>
                    <p class="muted">{{ ('2000-01-01 ' ~ next_appointment.appointmentTime)|date('g:i A') }} · {{ next_appointment.session }} · {{ next_appointment.dialysisType }}</p>
                    <span class="badge badge-{{ next_appointment.status|lower }}">{{ next_appointment.status }}</span>
                {% else %}
                    <p class="muted">No upcoming appointments. Explore a center to request a visit.</p>
                    <a class="text-link" href="{{ path('app_hospitals') }}">Browse dialysis centers →</a>
                {% endif %}
            </article>
            <article class="dashboard-highlight">
                <div class="dashboard-section-heading">
                    <span class="dashboard-highlight-icon" aria-hidden="true">⌁</span>
                    <div><h2>Latest request</h2><p class="muted">Most recently submitted</p></div>
                </div>
                {% if latest_appointment %}
                    <p class="highlight-date">{{ latest_appointment.createdAt|date('F j, Y') }}</p>
                    <strong>{{ latest_appointment.center }}</strong>
                    <p class="muted">{{ latest_appointment.appointmentDate|date('D, F j, Y') }} · {{ latest_appointment.dialysisType }}</p>
                    <span class="badge badge-{{ latest_appointment.status|lower }}">{{ latest_appointment.status }}</span>
                {% else %}
                    <p class="muted">Your submitted requests will appear here.</p>
                {% endif %}
            </article>
        </section>

        <section class="dashboard-appointments" id="appointments" aria-labelledby="appointments-title">
            <div class="dashboard-list-heading">
                <div>
                    <p class="dashboard-eyebrow">YOUR CARE SCHEDULE</p>
                    <h2 id="appointments-title">Appointments</h2>
                </div>
                <div class="dashboard-tabs" role="tablist" aria-label="Appointment group">
                    <a class="{{ view == 'upcoming' ? 'is-active' : '' }}" href="{{ path('app_dashboard', {view: 'upcoming'}) }}" {% if view == 'upcoming' %}aria-current="page"{% endif %}>Upcoming <span>{{ upcoming_count }}</span></a>
                    <a class="{{ view == 'history' ? 'is-active' : '' }}" href="{{ path('app_dashboard', {view: 'history'}) }}" {% if view == 'history' %}aria-current="page"{% endif %}>History <span>{{ history_count }}</span></a>
                </div>
            </div>

            <form class="appointment-filters" method="get" action="{{ path('app_dashboard') }}">
                <input type="hidden" name="view" value="{{ view }}">
                <label class="sr-only" for="appointment-search">Search appointments</label>
                <input id="appointment-search" type="search" name="q" value="{{ search }}" placeholder="Search center, type or date">
                <label class="sr-only" for="appointment-status">Filter by status</label>
                <select id="appointment-status" name="status">
                    <option value="">All statuses</option>
                    {% for status in ['Pending', 'Confirmed', 'Completed', 'Cancelled'] %}
                        <option value="{{ status }}" {{ status_filter == status ? 'selected' : '' }}>{{ status }}</option>
                    {% endfor %}
                </select>
                <button class="btn btn-filter" type="submit">Apply filters</button>
                {% if search or status_filter %}
                    <a class="text-link filter-clear" href="{{ path('app_dashboard', {view: view}) }}">Clear</a>
                {% endif %}
            </form>

            {% if appointments is not empty %}
                <div class="appointment-list">
                    {% for a in appointments %}
                        <article class="appointment-card">
                            <div class="appointment-date-block">
                                <span>{{ a.appointmentDate|date('M') }}</span>
                                <strong>{{ a.appointmentDate|date('d') }}</strong>
                                <small>{{ a.appointmentDate|date('Y') }}</small>
                            </div>
                            <div class="appointment-details">
                                <div class="appointment-title-row">
                                    <h3>{{ a.center }}</h3>
                                    <span class="badge badge-{{ a.status|lower }}">{{ a.status }}</span>
                                </div>
                                <p class="muted">{{ a.location }}</p>
                                <p>{{ a.dialysisType }} <span aria-hidden="true">·</span> {{ ('2000-01-01 ' ~ a.appointmentTime)|date('g:i A') }} <span aria-hidden="true">·</span> {{ a.session }}</p>
                            </div>
                            {% if a.id in can_cancel_ids %}
                                <form method="post" action="{{ path('app_appointment_cancel', {id: a.id}) }}" class="appointment-actions" onsubmit="return confirm('Cancel this pending appointment request?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ a.id) }}">
                                    <button type="submit" class="btn btn-outline">Cancel request</button>
                                </form>
                            {% endif %}
                        </article>
                    {% endfor %}
                </div>
            {% elseif search or status_filter %}
                <div class="dashboard-empty">
                    <span class="dashboard-empty-icon" aria-hidden="true">⌕</span>
                    <h3>No matching appointments</h3>
                    <p class="muted">Try another search or clear the filters.</p>
                    <a class="text-link" href="{{ path('app_dashboard', {view: view}) }}">Clear filters</a>
                </div>
            {% elseif view == 'upcoming' %}
                <div class="dashboard-empty">
                    <span class="dashboard-empty-icon" aria-hidden="true">＋</span>
                    <h3>No upcoming appointments</h3>
                    <p class="muted">When you request a dialysis visit, it will appear here. Your past and cancelled requests are available in History.</p>
                    <a class="btn" href="{{ path('app_hospitals') }}">Find a dialysis center</a>
                </div>
            {% else %}
                <div class="dashboard-empty">
                    <span class="dashboard-empty-icon" aria-hidden="true">⌂</span>
                    <h3>No appointment history yet</h3>
                    <p class="muted">Completed, past and cancelled appointments will be listed here.</p>
                    <a class="text-link" href="{{ path('app_dashboard', {view: 'upcoming'}) }}">View upcoming appointments</a>
                </div>
            {% endif %}
        </section>

        <nav class="dashboard-shortcuts" aria-label="More from KATOC">
            <a href="{{ path('app_hospitals') }}"><strong>Find a dialysis center</strong><span>Browse active centers and request a visit →</span></a>
            <a href="{{ path('app_about') }}"><strong>About KATOC</strong><span>Learn about the platform →</span></a>
            <a href="{{ path('app_home') }}"><strong>Care information</strong><span>Return to the KATOC home page →</span></a>
        </nav>
        <p class="dashboard-limit-note">Need to update your account or contact support? Those patient services are not currently available in this portal.</p>
    </main>
    </div>
</body>
</html>
